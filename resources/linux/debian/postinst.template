# Symlink bin command to /usr/bin
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Register code in the alternatives system
# Priority of 0 should never make code the default editor in auto mode as most
# developers would prefer a terminal editor as the default.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

# Install the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database to pickup workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# IDE Code intentionally does NOT register any apt repository or signing key.
# Updates are delivered outside of apt (see release notes); installing this
# package must not modify the user's apt configuration.
#
# Cleanup (parent decision 2026-10-21, deviating from fix-draft B §3.4):
# Earlier IDE Code .deb builds copied the upstream postinst and could write
# a third-party apt source and keyring (see the conditional block below).
# This block removes ONLY those legacy files, and ONLY when it is safe:
#  - the source file exists and its contents match the exact DEB822 pattern
#    the old postinst wrote (URI + Signed-By, see below), and
#  - the other editor's own package ('code') is NOT installed, and
#  - for the keyring, no remaining apt source file references it.
# If any check cannot be verified, the file is kept and a message is logged.
LEGACY_MS_SOURCE="/etc/apt/sources.list.d/vscode.sources"
LEGACY_MS_KEY="/usr/share/keyrings/microsoft.gpg"
if ! command -v dpkg-query >/dev/null 2>&1; then
	echo "@@NAME@@ postinst: keeping '$LEGACY_MS_SOURCE' and '$LEGACY_MS_KEY' if present: dpkg-query unavailable, cannot verify that package 'code' is not installed"
elif dpkg-query -W -f='${Status}' code 2>/dev/null | grep -q '^install ok installed$'; then
	echo "@@NAME@@ postinst: keeping '$LEGACY_MS_SOURCE' and '$LEGACY_MS_KEY' if present: package 'code' is installed"
else
	if [ -f "$LEGACY_MS_SOURCE" ]; then
		if grep -q 'https://packages.microsoft.com/repos/code' "$LEGACY_MS_SOURCE" && grep -Eq '^[[:space:]]*Signed-By:[[:space:]]*/usr/share/keyrings/microsoft\.gpg' "$LEGACY_MS_SOURCE"; then
			rm -f "$LEGACY_MS_SOURCE"
			echo "@@NAME@@ postinst: removed legacy '$LEGACY_MS_SOURCE' written by an earlier IDE Code build"
		else
			echo "@@NAME@@ postinst: keeping '$LEGACY_MS_SOURCE': contents do not match the pattern written by an earlier IDE Code build"
		fi
	fi
	if [ -f "$LEGACY_MS_KEY" ]; then
		if grep -qs 'microsoft\.gpg' /etc/apt/sources.list 2>/dev/null || grep -Rqs 'microsoft\.gpg' /etc/apt/sources.list.d/ 2>/dev/null; then
			echo "@@NAME@@ postinst: keeping '$LEGACY_MS_KEY': still referenced by an apt source file"
		else
			rm -f "$LEGACY_MS_KEY"
			echo "@@NAME@@ postinst: removed legacy '$LEGACY_MS_KEY' written by an earlier IDE Code build"
		fi
	fi
fi

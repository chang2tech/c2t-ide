rm -f /usr/bin/@@NAME@@

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# IDE Code does NOT remove any apt repository or signing key on uninstall.
# Earlier builds could add a third-party apt repository and signing key,
# but those files are shared with / owned by a real installation of that
# other editor, so this package must never delete them. Any conditional
# cleanup of legacy files written by earlier IDE Code builds happens only
# in postinst, under strict checks.

if [ "$1" = "purge" ] && [ -e '/usr/share/debconf/confmodule' ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi

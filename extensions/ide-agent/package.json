    "keybindings": [
      {
        "command": "ide.newFollowup",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "ideAgent.chatInputFocused"
      },
      {
        "command": "ide.approveShellTool",
        "key": "enter",
        "when": "ideAgent.toolApprovalVisible"
      },
      {
        "command": "ide.approveShellToolAllowlist",
        "key": "shift+enter",
        "when": "ideAgent.toolApprovalVisible"
      },
      {
        "command": "ide.cancelAgentStep",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.closeChatTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.findInChat",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.hideFindInChat",
        "key": "escape",
        "when": "focusedView == 'ideAgent.chatView' && !ideAgent.toolApprovalVisible"
      },
      {
        "command": "ide.newAgentChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "ide.openAddContextMenu",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.openModeMenu",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.openModelPicker",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "!editorTextFocus"
      },
      {
        "command": "ide.skipShellTool",
        "key": "escape",
        "when": "ideAgent.toolApprovalVisible"
      },
      {
        "command": "ide.openInlinePrompt",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "ide.acceptInlineEdit",
        "key": "ctrl+enter",
        "mac": "ctrl+enter",
        "when": "ideAgent.inlineEditPending && editorTextFocus"
      },
      {
        "command": "ide.rejectInlineEdit",
        "key": "escape",
        "mac": "escape",
        "when": "ideAgent.inlineEditPending && editorTextFocus"
      },
      {
        "command": "ide.toggleChatAsEditor",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.selectNextChat",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.selectPreviousChat",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.acceptTabSuggestionPartial",
        "key": "ctrl+right",
        "mac": "ctrl+right",
        "when": "inlineSuggestionVisible && config.ide.tab.enablePartialAccepts"
      },
      {
        "command": "ide.triggerTabSuggestion",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus"
      },
      {
        "command": "ide.abortTabRequests",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "ide.openAgentsWindow",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "!editorTextFocus && !terminalFocus"
      },
      {
        "command": "ide.toggleTabCompletion",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "!editorTextFocus && !ideAgent.chatInputFocused"
      },
      {
        "command": "ide.fixWithAI",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "ide.addToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "terminalFocus",
        "args": {
          "source": "terminal"
        }
      },
      {
        "command": "ide.addToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus || ideAgent.chatInputFocused",
        "args": {
          "source": "editor"
        }
      },
      {
        "command": "ide.newChat",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.cancelAgentStep",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "ideAgent.chatInputFocused"
      },
      {
        "command": "ide.worktreeCommand",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "ideAgent.chatInputFocused"
      },
      {
        "command": "ide.cycleModel",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "ideAgent.chatInputFocused"
      },
      {
        "command": "ide.terminalAiCommand",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "terminalFocus"
      },
      {
        "command": "ide.rejectInlineEdit",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "ideAgent.inlineEditPending"
      },
      {
        "command": "ide.toggleChatAsEditor",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.addSelectionToInlinePrompt",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus"
      },
      {
        "command": "ide.focusEditorFromDiff",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "ideAgent.inlineEditPending && !terminalFocus"
      },
      {
        "command": "ide.toggleChatAsEditor",
        "key": "ctrl+alt+e",
        "when": "focusedView == 'ideAgent.chatView'"
      },
      {
        "command": "ide.browserTab.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == ideAgent.browserTab"
      },
      {
        "command": "ide.browserTab.reloadTab",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == ideAgent.browserTab"
      },
      {
        "command": "ide.browserTab.focusOmnibar",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "activeWebviewPanelId == ideAgent.browserTab"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ide.newChat",
          "group": "navigation",
          "when": "view == 'ideAgent.sessionsView'"
        }
      ],
      "editor/title/context": [
        {
          "command": "ide.exportTranscript",
          "group": "1_chat@1",
          "when": "resourceScheme == 'ide-chat'"
        },
        {
          "command": "ide.copyRequestId",
          "group": "1_chat@2",
          "when": "resourceScheme == 'ide-chat'"
        },
        {
          "command": "ide.giveFeedback",
          "group": "1_chat@3",
          "when": "resourceScheme == 'ide-chat'"
        },
        {
          "command": "ide.renameChat",
          "group": "1_chat@4",
          "when": "resourceScheme == 'ide-chat'"
        },
        {
          "command": "ide.forkChat",
          "group": "1_chat@5",
          "when": "resourceScheme == 'ide-chat'"
        },
        {
          "command": "ide.openAgentSettings",
          "group": "2_settings",
          "when": "resourceScheme == 'ide-chat'"
        }
      ],
      "editor/context": [
        {
          "command": "ide.addToChat",
          "group": "ideAgent@1",
          "when": "editorHasSelection",
          "args": {
            "source": "editor"
          }
        }
      ],
      "commandPalette": [
        {
          "command": "ide.exportTranscript",
          "when": "never"
        },
        {
          "command": "ide.copyRequestId",
          "when": "never"
        },
        {
          "command": "ide.giveFeedback",
          "when": "never"
        },
        {
          "command": "ide.renameChat",
          "when": "never"
        },
        {
          "command": "ide.forkChat",
          "when": "never"
        },
        {
          "command": "ide.openAgentSettings",
          "when": "never"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ideAgent.chatEditor",
        "displayName": "IDE Agent Chat",
        "selector": [
          {
            "scheme": "ide-chat"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "ideAgent": [
        {
          "id": "ideAgent.chatView",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "ideAgent.sessionsView",
          "name": "Sessions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "media/icon.svg",
          "id": "ideAgent",
          "title": "IDE Agent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "contents": "No agent sessions yet.\nRun [New Chat](command:ide.newChat) to start.",
        "view": "ideAgent.sessionsView"
      }
    ]
  },
  "description": "Built-in AI agent extension for the ide-code VS Code fork (scaffold — engine wiring pending). Mirrors Cursor's composer/aichat/cmdk command surface under the ide.* namespace.",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "displayName": "IDE Agent",
  "enabledApiProposals": [
    "terminalDataWriteEvent",
    "browser"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "ide-agent",
  "publisher": "ide-code",
  "scripts": {
    "check": "tsc --noEmit -p ./",
    "compile": "tsc -p ./"
  },
  "version": "0.1.0"
}

  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A3BE8C"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Number and constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B48EAD"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "Class and type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#EBCB8B"
      }
    },
    {
      "name": "Variable and parameter",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.property",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0F0F0"
      }
    },
    {
      "name": "Tag name (markup)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Attribute name",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "CSS/JSON property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "Decorator and annotation",
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F1B467"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D2943E"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FC6B83"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "markup.deprecated",
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#F0F0F05C"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#EBCB8B",
    "comment": "#6A9955",
    "enumMember": "#B48EAD",
    "function": "#88C0D0",
    "keyword": "#81A1C1",
    "method": "#88C0D0",
    "number": "#B48EAD",
    "parameter": "#F0F0F0",
    "string": "#A3BE8C",
    "type": "#EBCB8B",
    "variable.readonly": "#F0F0F0"
  }
}
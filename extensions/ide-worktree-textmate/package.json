          "**/*-worktrees/**/*.rb"
        ]
      },
      {
        "id": "worktree-rust",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.rs",
          "**/*-worktrees/**/*.rs"
        ]
      },
      {
        "id": "worktree-shellscript",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.sh",
          "**/.ide-code/worktrees/**/*.bash",
          "**/*-worktrees/**/*.sh",
          "**/*-worktrees/**/*.bash"
        ]
      },
      {
        "id": "worktree-sql",
        "filenamePatterns": [

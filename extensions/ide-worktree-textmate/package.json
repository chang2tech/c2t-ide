          "**/*-worktrees/**/*.jsx"
        ]
      },
      {
        "id": "worktree-json",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.json",
          "**/*-worktrees/**/*.json"
        ]
      },
      {
        "id": "worktree-php",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.php",
          "**/*-worktrees/**/*.php"
        ]
      },
      {
        "id": "worktree-protobuf",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.proto",
          "**/*-worktrees/**/*.proto"
        ]
      },
      {
        "id": "worktree-python",

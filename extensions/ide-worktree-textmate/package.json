    "configuration": {
      "title": "IDE Worktrees",
      "properties": {
        "ide.worktree.lspWorktreesEnabled": {
          "title": "Enable LSPs for Worktrees",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable language server by default to provide code intelligence in agent worktree workspaces",
          "tags": [
            "language server",
            "worktree"
          ],
          "scope": "window"
        }
      }
    },
    "configurationDefaults": {
      "[worktree-c]": {
        "editor.semanticHighlighting.enabled": false
      },
      "[worktree-cpp]": {
        "editor.semanticHighlighting.enabled": false

{
  "name": "ide-worktree-textmate",
  "displayName": "Worktree TextMate Syntax",
  "description": "Provides TextMate-only syntax highlighting for .ide-code/worktrees files without activating language servers.",
  "version": "0.0.1",
  "publisher": "ide-code",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "worktree-c",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.c",
          "**/*-worktrees/**/*.c"
        ]
      },
      {
        "id": "worktree-cpp",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.cpp",
          "**/.ide-code/worktrees/**/*.h",
          "**/.ide-code/worktrees/**/*.hpp",
          "**/*-worktrees/**/*.cpp",
          "**/*-worktrees/**/*.h",
          "**/*-worktrees/**/*.hpp"
        ]
      },
      {
        "id": "worktree-css",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.css",
          "**/*-worktrees/**/*.css"
        ]
      },
      {
        "id": "worktree-go",

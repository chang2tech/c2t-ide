      {
        "id": "worktree-terraform-deploy",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.tfdeploy.hcl",
          "**/*-worktrees/**/*.tfdeploy.hcl"
        ]
      },
      {
        "id": "worktree-terraform-test",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.tftest.hcl",

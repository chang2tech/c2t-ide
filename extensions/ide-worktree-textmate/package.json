          "**/*-worktrees/**/*.tsx"
        ]
      },
      {
        "id": "worktree-yaml",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.yaml",
          "**/.ide-code/worktrees/**/*.yml",
          "**/*-worktrees/**/*.yaml",
          "**/*-worktrees/**/*.yml"
        ]
      },
      {
        "id": "worktree-terraform",
        "filenamePatterns": [
          "**/.ide-code/worktrees/**/*.tf",
          "**/*-worktrees/**/*.tf"
